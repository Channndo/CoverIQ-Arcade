# CoverIQ site that owns accounts (Syntrix). Safe defaults are used if unset.
VITE_COVERIQ_SITE_URL=https://cover-iq.com

# Isolated leaderboard API on the CoverIQ site. Existing deploys keep working
# without this — the hub falls back to https://cover-iq.com/api/arcade-stats
# and fail-opens (empty boards) if the endpoint is unreachable.
VITE_ARCADE_STATS_URL=https://cover-iq.com/api/arcade-stats
